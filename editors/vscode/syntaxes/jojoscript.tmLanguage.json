{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JojoScript",
  "scopeName": "source.jojo",
  "patterns": [
    { "include": "#jojo-contract-clause" },
    { "include": "#jojo-pipeline-declaration" },
    { "include": "#jojo-pipeline-source" },
    { "include": "#jojo-type-declaration" },
    { "include": "#jojo-effect-declaration" },
    { "include": "#jojo-purity-modifier" },
    { "include": "#jojo-function-signature" },
    { "include": "#jojo-handle-keyword" },
    { "include": "#jojo-mutable" },
    { "include": "#jojo-match-keyword" },
    { "include": "#jojo-constructor-pattern" },
    { "include": "#jojo-wildcard-arm" },
    { "include": "#jojo-declaration-operator" },
    { "include": "#jojo-pipeline-operator" },
    { "include": "#jojo-stage-id" },
    { "include": "#jojo-placeholder" },
    { "include": "source.js" }
  ],
  "repository": {
    "jojo-mutable": {
      "match": "\\bmutable\\b",
      "name": "storage.modifier.jojo"
    },
    "jojo-match-keyword": {
      "comment": "`match <expr> { ... }` expression keyword, distinguished from `foo.match(...)`",
      "match": "(?<![.\\w$])\\bmatch\\b(?=\\s)",
      "name": "keyword.control.match.jojo"
    },
    "jojo-constructor-pattern": {
      "comment": "A tagged-union constructor pattern in a match arm, e.g. `Ok(value) => ...`",
      "match": "\\b([A-Z][\\w$]*)(?=\\s*\\([^()]*\\)\\s*=>)",
      "captures": {
        "1": { "name": "entity.name.type.variant.jojo" }
      }
    },
    "jojo-wildcard-arm": {
      "comment": "The default `_ => ...` arm of a match expression",
      "match": "(?<![\\w$])_(?=\\s*=>)",
      "name": "variable.language.wildcard.jojo"
    },
    "jojo-declaration-operator": {
      "comment": "Immutable/mutable declaration operator, e.g. `users := getUsers()`",
      "match": ":=",
      "name": "keyword.operator.declaration.jojo"
    },
    "jojo-pipeline-operator": {
      "comment": "Pipeline stage operator, e.g. `users |> filter(isAdult)`",
      "match": "\\|>",
      "name": "keyword.operator.pipeline.jojo"
    },
    "jojo-stage-id": {
      "comment": "A stage ID label after a pipeline stage, e.g. `|> map(enrich) @enrich`",
      "match": "(?<=\\s)@[A-Za-z_][\\w-]*",
      "name": "entity.name.tag.stage-id.jojo"
    },
    "jojo-placeholder": {
      "comment": "The `_` pipeline placeholder argument, e.g. `divide(100, _)`",
      "match": "(?<=[(,]\\s*)_(?=\\s*[,)])",
      "name": "variable.language.placeholder.jojo"
    },
    "jojo-pipeline-declaration": {
      "comment": "Named pipeline declaration, e.g. `export pipeline enrichOrders {`",
      "match": "^\\s*(?:(export)\\s+)?(pipeline)\\s+([A-Za-z_$][\\w$]*)(?=\\s*\\{)",
      "captures": {
        "1": { "name": "storage.modifier.export.jojo" },
        "2": { "name": "storage.type.pipeline.jojo" },
        "3": { "name": "entity.name.function.pipeline.jojo" }
      }
    },
    "jojo-pipeline-source": {
      "comment": "The `source <expression>` line that starts a named pipeline",
      "match": "^\\s*(source)(?=\\s+[^\\s=:])",
      "captures": {
        "1": { "name": "keyword.other.source.jojo" }
      }
    },
    "jojo-type-declaration": {
      "comment": "Tagged union declaration, e.g. `type Result = | Ok(value) | Failed(message)`, possibly over several `|` lines",
      "begin": "^\\s*(?:(export)\\s+)?(type)\\s+([A-Za-z_$][\\w$]*)\\s*(=)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.export.jojo" },
        "2": { "name": "storage.type.type.jojo" },
        "3": { "name": "entity.name.type.jojo" },
        "4": { "name": "keyword.operator.assignment.jojo" }
      },
      "end": "^(?!\\s*\\|)",
      "name": "meta.type.declaration.jojo",
      "patterns": [
        {
          "match": "([A-Z][\\w$]*)(?:\\s*(\\()([^()]*)(\\)))?",
          "captures": {
            "1": { "name": "entity.name.type.variant.jojo" },
            "2": { "name": "punctuation.definition.parameters.begin.jojo" },
            "3": { "name": "variable.parameter.jojo" },
            "4": { "name": "punctuation.definition.parameters.end.jojo" }
          }
        },
        {
          "match": "\\|",
          "name": "punctuation.separator.variant.jojo"
        }
      ]
    },
    "jojo-effect-declaration": {
      "comment": "Effect declaration, e.g. `effect fetchUser(id)`",
      "match": "^\\s*(?:(export)\\s+)?(effect)\\s+([A-Za-z_$][\\w$]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "storage.modifier.export.jojo" },
        "2": { "name": "storage.type.effect.jojo" },
        "3": { "name": "entity.name.function.effect.jojo" }
      }
    },
    "jojo-handle-keyword": {
      "comment": "`handle { handlers } { body }` block keyword, distinguished from `stream.handle(...)`",
      "match": "(?<![.\\w$])handle(?=\\s*\\{)",
      "name": "keyword.control.handle.jojo"
    },
    "jojo-purity-modifier": {
      "comment": "`pure fn` / `effectful fn` purity declarations",
      "match": "\\b(pure|effectful)\\b(?=\\s+(?:async\\s+)?fn\\b)",
      "name": "storage.modifier.purity.jojo"
    },
    "jojo-contract-clause": {
      "comment": "`requires` / `ensures` contract clauses on their own lines between a signature and its `{`",
      "begin": "^(\\s*)(requires|ensures)\\b",
      "beginCaptures": {
        "2": { "name": "keyword.control.contract.jojo" }
      },
      "end": "$",
      "name": "meta.contract.jojo",
      "patterns": [
        {
          "match": "\\bresult\\b",
          "name": "variable.language.result.jojo"
        },
        { "include": "source.js" }
      ]
    },
    "jojo-function-signature": {
      "comment": "`fn name(params): ReturnType {` / `fn name(params): ReturnType = expr` — scopes optional type annotations and contract clauses to the signature, so ordinary object literals elsewhere are never mistaken for type annotations. Comparison operators such as `!=` or `>=` inside contracts do not end the signature.",
      "begin": "\\b(async\\s+)?(fn)\\b(\\s+([A-Za-z_$][\\w$]*))?",
      "beginCaptures": {
        "1": { "name": "storage.modifier.async.jojo" },
        "2": { "name": "storage.type.function.jojo" },
        "4": { "name": "entity.name.function.jojo" }
      },
      "end": "(?=\\{|(?<![!<>=])=(?![=>]))",
      "name": "meta.function.signature.jojo",
      "patterns": [
        { "include": "#jojo-contract-clause" },
        {
          "comment": "Return type annotation after the closing `)`, e.g. `): number`",
          "match": "(\\))\\s*(:)\\s*([A-Za-z_$][\\w$.<>\\[\\]]*)",
          "captures": {
            "1": { "name": "punctuation.definition.parameters.end.jojo" },
            "2": { "name": "punctuation.separator.annotation.jojo" },
            "3": { "name": "entity.name.type.jojo" }
          }
        },
        {
          "comment": "Parameter type annotation, e.g. `a: number`",
          "match": "([A-Za-z_$][\\w$]*)\\s*(:)\\s*([A-Za-z_$][\\w$.<>\\[\\]]*)",
          "captures": {
            "1": { "name": "variable.parameter.jojo" },
            "2": { "name": "punctuation.separator.annotation.jojo" },
            "3": { "name": "entity.name.type.jojo" }
          }
        },
        { "include": "source.js" }
      ]
    }
  }
}
