/*
 * Additional collection runtime stages: `groupBy`, `partition`, `chunk`,
 * `window`, `zip`, `zipWith`, `scan`, `sortBy`, `distinctBy`, and `tap`.
 */

export fn groupPostsByUser(posts) {
  return posts |> groupBy(post => post.userId)
}

export fn splitByPublished(posts) {
  return posts |> partition(post => post.published)
}

export fn pageify(posts, pageSize) {
  return posts
    |> chunk(pageSize)
    |> toArray
}

export fn movingAverages(values, size) {
  return values
    |> window(size)
    |> map(group => group.reduce((sum, value) => sum + value, 0) / group.length)
    |> toArray
}

export fn pairTitlesWithIds(posts) {
  ids := posts |> map(post => post.id) |> toArray

  titles := posts |> map(post => post.title) |> toArray

  return ids |> zip(titles) |> toArray
}

export fn labelTitlesWithIds(posts) {
  ids := posts |> map(post => post.id) |> toArray

  titles := posts |> map(post => post.title) |> toArray

  return ids
    |> zipWith(titles, (id, title) => `${id}: ${title}`)
    |> toArray
}

export fn runningWordCount(posts) {
  return posts
    |> map(post => post.body.split(/\s+/).filter(Boolean).length)
    |> scan((total, count) => total + count, 0)
    |> toArray
}

export fn postsSortedByTitle(posts) {
  return posts |> sortBy(post => post.title)
}

export fn uniquePostsByUser(posts) {
  return posts
    |> distinctBy(post => post.userId)
    |> toArray
}

export fn loggedPosts(posts, logger) {
  return posts
    |> tap(post => logger(post.id))
    |> toArray
}
