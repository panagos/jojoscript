/*
 * The `_` placeholder controls where the piped value lands in a pipeline
 * stage's argument list, instead of always being the first argument.
 */

export function percentageOf(value, total) {
  return value / total * 100
}

export function toPercentageOfTotal(values, total) {
  return values
    |> map(value => percentageOf(value, total))
    |> toArray
}

export function subtractFromBudget(spend, budget) {
  return budget
    |> subtract(_, spend)
    |> Math.max(0, _)
}

function subtract(a, b) {
  return a - b
}
