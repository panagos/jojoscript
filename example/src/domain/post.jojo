export function createPost({ id, userId, title, body }) {
  if (!Number.isInteger(id) || id <= 0) {
    throw new Error("Post id must be a positive integer")
  }

  if (!Number.isInteger(userId) || userId <= 0) {
    throw new Error("Post userId must be a positive integer")
  }

  if (!title?.trim()) {
    throw new Error("Post title is required")
  }

  if (!body?.trim()) {
    throw new Error("Post body is required")
  }

  return {
    id,
    userId,
    title: title.trim(),
    body: body.trim()
  }
}

export function isLongPost(post, minimumLength = 100) {
  return post.body.length >= minimumLength
}
